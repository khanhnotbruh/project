<?xml version="1.0" encoding="utf-8"?>
<shell xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <theme>
        <style class="KPromeTab-Lock-Wps">
            <color value="#0000001a" name="background"/>
            <color value="#00000033" name="background-hover"/>
            <color value="#000000b3" name="text"/>
        </style>
        <style class="KPromeTab-Lock-Pdf">
            <color value="#0000001a" name="background"/>
            <color value="#00000033" name="background-hover"/>
            <color value="#000000b3" name="text"/>
        </style>
        <style class="KPromeTab-Lock-Wpp">
            <color value="#0000001a" name="background"/>
            <color value="#00000033" name="background-hover"/>
            <color value="#000000b3" name="text"/>
        </style>
        <style class="KPromeHeaderBar">
            <linearGradient end="0,1" start="0,0" spread="pad" name="background">
                <color value="#ffffffff" position="0"/>
            </linearGradient>
            <hint value="0" name="disableDrawBackground"/>
        </style>
        <style class="KPromeTab">
            <color value="#0000001a" name="background"/>
            <color value="#00000033" name="background-hover"/>
            <color value="#000000b3" name="text"/>
        </style>
        <style class="KPromeTab-Lock-Et">
            <color value="#0000001a" name="background"/>
            <color value="#00000033" name="background-hover"/>
            <color value="#000000b3" name="text"/>
        </style>
        <style class="KScrollWidget_IconColor">
            <color value="#000000ff" name="IconBaseColor"/>
            <color value="#000000ff" name="IconThemeColor"/>
        </style>
        <style class="KPromeTab-StartPage">
            <color value="#0038994d" name="background"/>
            <color value="#0038997f" name="background-hover"/>
        </style>
        <style class="KPromeTab-Et">
            <color value="#0000001a" name="background"/>
            <color value="#00000033" name="background-hover"/>
            <color value="#000000b3" name="text"/>
        </style>
        <style class="KPromeTab-Lock">
            <color value="#0000001a" name="background"/>
            <color value="#00000033" name="background-hover"/>
            <color value="#000000b3" name="text"/>
        </style>
        <style class="KPromeHeaderAvatar">
            <color value="#000000b3" name="text"/>
            <color value="#000000b3" name="text-hover"/>
        </style>
        <style class="KWindowTitleButtonGroup_IconColor">
            <color value="#000000ff" name="IconBaseColor"/>
            <color value="#000000ff" name="IconThemeColor"/>
        </style>
        <style class="KPromeTab-Wpp">
            <color value="#0000001a" name="background"/>
            <color value="#00000033" name="background-hover"/>
            <color value="#000000b3" name="text"/>
        </style>
        <style class="KPromeTabBar_IconColor">
            <color value="#000000ff" name="IconBaseColor"/>
            <color value="#000000ff" name="IconThemeColor"/>
        </style>
        <style class="KPromeTab-Wps">
            <color value="#0000001a" name="background"/>
            <color value="#00000033" name="background-hover"/>
            <color value="#000000b3" name="text"/>
        </style>
        <style class="KPromeTab-Pdf">
            <color value="#0000001a" name="background"/>
            <color value="#00000033" name="background-hover"/>
            <color value="#000000b3" name="text"/>
        </style>
    </theme>
</shell>
